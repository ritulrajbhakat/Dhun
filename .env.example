# ==============================================================================
# 1. GLOBAL SHARED SONG METADATA CATALOGUE (Firebase Cloud Firestore — Spark Plan)
# Stores ONLY reusable song metadata. Zero audio binaries, zero cloud audio processing.
# Operates completely within the free Firebase Spark plan (50k reads/day, 20k writes/day).
# ==============================================================================
# Public Firebase project ID and Web API key (Anonymous Auth enabled)
DHUN_FIREBASE_PROJECT_ID=your-firebase-project-id
DHUN_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key

# Legacy optional self-hosted metadata server (omit if using Cloud Firestore)
PORT=8080
DATABASE_URL=./dhun_global_catalogue.db
DHUN_CATALOGUE_SERVICE_KEY=replace_with_strong_random_service_key

# ==============================================================================
# 2. LOCAL DHUN HELPER SERVICE (`dhun-local-helper` — Host Laptop)
# Runs locally while the party is active. Manages private LAN room & temp cache.
# ==============================================================================
DHUN_LOCAL_PORT=47821
DHUN_LOCAL_DB_PATH=./dhun_local_helper.db
DHUN_CACHE_DIR=./dhun_temp_cache
# Optional comma-separated public frontend origins allowed via CORS + PNA (e.g. Vercel URL)
DHUN_ALLOWED_ORIGINS=https://dhun.vercel.app
# Optional remote Global Metadata Catalogue URL (HTTPS required; omit for 100% offline mode)
DHUN_GLOBAL_CATALOGUE_URL=

# ==============================================================================
# 3. PUBLIC WEB FRONTEND (Vercel — Vite env vars)
# ==============================================================================
# Optional direct download URL for the one-click Windows installer (DHUN-Local-Helper-Setup.exe)
VITE_HELPER_DOWNLOAD_URL=https://github.com/ritulrajbhakat/Dhun/actions
