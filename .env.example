# DHUN Cloud Server Configuration Example
# Copy to .env or configure in cloud provider environment settings (Render, Railway, Fly.io)

# Server port to bind (provided dynamically by cloud providers like Render/Railway)
PORT=8080

# SQLite database file location
DATABASE_URL=./dhun.db

# Public frontend base URL where guests and hosts access the web UI
PUBLIC_GUEST_URL=https://ritulrajbhakat.github.io/Dhun

# Allowed CORS origins (* for public or specific frontend origin)
CORS_ORIGIN=*

# Optional secret for administration & metadata sync
DHUN_API_SECRET=your_secure_secret_here
